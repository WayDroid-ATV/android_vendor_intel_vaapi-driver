package {
    default_applicable_licenses: ["external_intel_vaapi_driver_license"],
}

license {
    name: "external_intel_vaapi_driver_license",
    visibility: [":__subpackages__"],
    license_text: ["COPYING"],
}

cc_library_shared {
    name: "i965_drv_video",
    vendor: true,

    srcs: [
        "src/dso_utils.c",
        "src/gen6_mfc.c",
        "src/gen6_mfc_common.c",
        "src/gen6_mfd.c",
        "src/gen6_vme.c",
        "src/gen7_vme.c",
        "src/gen7_mfc.c",
        "src/gen7_mfd.c",
        "src/gen75_mfd.c",
        "src/gen75_mfc.c",
        "src/gen8_encoder_vp8.c",
        "src/gen8_mfc.c",
        "src/gen8_mfd.c",
        "src/gen8_vme.c",
        "src/gen9_encoder_vp8.c",
        "src/gen9_vme.c",
        "src/gen9_mfc.c",
        "src/gen9_mfc_hevc.c",
        "src/gen9_mfd.c",
        "src/gen9_vdenc.c",
        "src/gen75_picture_process.c",
        "src/gen75_vme.c",
        "src/gen75_vpp_gpe.c",
        "src/gen75_vpp_vebox.c",
        "src/gen9_post_processing.c",
        "src/i965_avc_bsd.c",
        "src/i965_avc_hw_scoreboard.c",
        "src/i965_avc_ildb.c",
        "src/i965_decoder_utils.c",
        "src/i965_device_info.c",
        "src/i965_drv_video.c",
        "src/i965_encoder.c",
        "src/i965_encoder_utils.c",
        "src/i965_encoder_vp8.c",
        "src/i965_media.c",
        "src/i965_media_h264.c",
        "src/i965_media_mpeg2.c",
        "src/i965_gpe_utils.c",
        "src/i965_post_processing.c",
        "src/i965_yuv_coefs.c",
        "src/gen8_post_processing.c",
        "src/i965_render.c",
        "src/i965_vpp_avs.c",
        "src/gen8_render.c",
        "src/gen9_render.c",
        "src/intel_batchbuffer.c",
        "src/intel_batchbuffer_dump.c",
        "src/intel_driver.c",
        "src/intel_memman.c",
        "src/object_heap.c",
        "src/intel_media_common.c",
        "src/vp8_probs.c",
        "src/vp9_probs.c",
        "src/vpx_quant.c",
        "src/gen9_vp9_encoder_kernels.c",
        "src/gen9_vp9_const_def.c",
        "src/gen9_vp9_encoder.c",
        "src/intel_common_vpp_internal.c",
        "src/i965_encoder_const_def.c",
        "src/i965_avc_const_def.c",
        "src/i965_avc_encoder_kernels.c",
        "src/i965_avc_encoder_common.c",
        "src/i965_avc_encoder.c",
        "src/gen9_hevc_enc_kernels_binary.c",
        "src/gen9_hevc_encoder.c",
        "src/gen9_hevc_enc_utils.c",
        "src/gen10_encoder_vp8.c",
        "src/gen10_hcp_common.c",
        "src/gen10_hevc_enc_kernels_binary.c",
        "src/gen10_hevc_enc_common.c",
        "src/gen10_hevc_encoder.c",
        "src/gen10_huc_common.c",
        "src/gen10_vdenc_common.c",
        "src/gen10_vdenc_vp9.c",
    ],

    cflags: [
        "-Wall",
        "-Wno-unused",
        "-fvisibility=hidden",
	    "-Wno-missing-field-initializers",
	    "-Wno-unused-parameter",
	    "-Wno-pointer-arith",
	    "-Wno-sign-compare",
    ],

    shared_libs: [
        "libdl",
        "libdrm",
        "libdrm_intel",
        "libcutils",
        "libva",
        "libva-android",
    ],

    header_libs: ["libva_headers"],

    enabled: false,
    compile_multilib: "first",
    arch: {
        x86: {
            enabled: true,
        },
        x86_64: {
            enabled: true,
        },
    },
}
